{
  "description": "Quarterback's hard rules: never merge, never push to the default branch, never force-push, and the implementer isn't done while the milestone's check fails.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*__(merge_pull_request|push_files|create_or_update_file|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_git.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^quarterback:implementer$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_gate.py\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
